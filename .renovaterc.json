{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(build)"
  ],
  "timezone": "Europe/Amsterdam",
  "schedule": [
    "before 6am on monday"
  ],
  "enabledManagers": [
    "github-actions",
    "dockerfile",
    "docker-compose",
    "pre-commit",
    "terraform",
    "terraform-version",
    "ansible-galaxy",
    "custom.regex"
  ],
  "pinDigests": true,
  "minimumReleaseAge": "7 days",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "automerge": false,
  "platformAutomerge": false,
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Python packages are owned by Dependabot; pre-commit Python tools run as local hooks through uv, so no PyPI dependency is managed here",
      "matchDatasources": [
        "pypi"
      ],
      "enabled": false
    },
    {
      "description": "The Python runtime version is changed only by a deliberate pull request with full testing",
      "matchDatasources": [
        "python-version"
      ],
      "enabled": false
    },
    {
      "description": "setup-python resolves Python versions through actions/python-versions; the runtime is changed only by a deliberate pull request",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/python-versions"
      ],
      "enabled": false
    },
    {
      "description": "Major updates wait longer and are labelled for review; nobody is asked to approve them on the dashboard",
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "14 days",
      "addLabels": [
        "breaking-change"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "ci"
      ],
      "groupName": "github-actions"
    },
    {
      "matchManagers": [
        "pre-commit"
      ],
      "addLabels": [
        "ci"
      ],
      "groupName": "pre-commit hooks"
    },
    {
      "matchManagers": [
        "terraform",
        "terraform-version"
      ],
      "addLabels": [
        "area/aws"
      ]
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "extensions/packer/**"
      ],
      "addLabels": [
        "area/packer"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Packer required_plugins blocks",
      "managerFilePatterns": [
        "/^extensions/packer/.+\\.pkr\\.hcl$/"
      ],
      "matchStrings": [
        "source\\s*=\\s*\"github\\.com/(?<org>[^/\"]+)/(?<plugin>[^/\"]+)\"\\s*\\n\\s*version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "{{{org}}}/packer-plugin-{{{plugin}}}",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Digest of the CodeBuild builder image quay.io/buildah/stable (immutable release tag in the variable description); bump EXPECTED_BUILDAH_VERSION in the runner repository in step",
      "managerFilePatterns": [
        "/^infra/account/variables\\.tf$/"
      ],
      "matchStrings": [
        "\\(Buildah (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+-immutable), run rootless by the build script\\)\\.\"\\n\\s+type\\s+= string\\n\\s+default\\s+= \"(?<depName>quay\\.io/buildah/stable)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-immutable$"
    }
  ],
  "pre-commit": {
    "enabled": true
  }
}
