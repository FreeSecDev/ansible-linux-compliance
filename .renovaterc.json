{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(build)"
  ],
  "timezone": "Europe/Amsterdam",
  "schedule": ["before 6am on monday"],
  "enabledManagers": [
    "github-actions",
    "dockerfile",
    "docker-compose",
    "pre-commit",
    "terraform",
    "terraform-version",
    "ansible-galaxy",
    "custom.regex"
  ],
  "pinDigests": true,
  "minimumReleaseAge": "7 days",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "automerge": false,
  "platformAutomerge": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"],
    "minimumReleaseAge": null,
    "schedule": ["at any time"],
    "prCreation": "immediate"
  },
  "packageRules": [
    {
      "description": "Python ecosystems are owned by Dependabot",
      "matchManagers": [
        "pep621",
        "pip_requirements",
        "pip_setup",
        "pipenv",
        "poetry",
        "setup-cfg"
      ],
      "enabled": false
    },
    {
      "description": "Major updates need dashboard approval",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["ci"],
      "groupName": "github-actions"
    },
    {
      "matchManagers": ["pre-commit"],
      "addLabels": ["ci"],
      "groupName": "pre-commit hooks"
    },
    {
      "matchManagers": ["terraform", "terraform-version"],
      "addLabels": ["area/aws"]
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["extensions/packer/**"],
      "addLabels": ["area/packer"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Packer required_plugins blocks",
      "managerFilePatterns": ["/^extensions/packer/.+\\.pkr\\.hcl$/"],
      "matchStrings": [
        "source\\s*=\\s*\"github\\.com/(?<org>[^/\"]+)/(?<plugin>[^/\"]+)\"\\s*\\n\\s*version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "{{{org}}}/packer-plugin-{{{plugin}}}",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ]
}
