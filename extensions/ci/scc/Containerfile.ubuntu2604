FROM docker.io/library/ubuntu:26.04@sha256:c098726dd9b9733f3e885f8de0ef375206a311b0a317eadc40d347b1115fb944

ARG SCC_VERSION
ARG SCC_DEB_SHA256
ARG SCC_CSCC_SHA256

LABEL org.opencontainers.image.title="freesecdev-scc-ci-ubuntu2604" \
      org.opencontainers.image.description="CI-only SCAP Compliance Checker image on Ubuntu 26.04 for the off-platform test, built locally and never published" \
      org.opencontainers.image.source="https://github.com/FreeSecDev/ansible-linux-compliance" \
      org.opencontainers.image.licenses="NOASSERTION" \
      org.opencontainers.image.version="${SCC_VERSION}"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY --chmod=0644 scc.deb /tmp/scc.deb

RUN [[ "${SCC_VERSION}" =~ ^[0-9]+(\.[0-9]+)+$ ]] \
    && [[ "${SCC_DEB_SHA256}" =~ ^[0-9a-f]{64}$ ]] \
    && [[ "${SCC_CSCC_SHA256}" =~ ^[0-9a-f]{64}$ ]] \
    && printf '%s  %s\n' "${SCC_DEB_SHA256}" /tmp/scc.deb | sha256sum --check --strict \
    && dpkg --install /tmp/scc.deb \
    && rm -f /tmp/scc.deb \
    && test "$(dpkg-query --show --showformat='${Version}' spawarscc)" = "${SCC_VERSION}" \
    && printf '%s  %s\n' "${SCC_CSCC_SHA256}" /opt/scc/cscc | sha256sum --check --strict \
    && test "$(stat -c '%u:%g:%a' /opt/scc/cscc)" = '0:0:755'

WORKDIR /opt/scc
ENTRYPOINT ["/opt/scc/cscc"]
CMD ["--version"]
