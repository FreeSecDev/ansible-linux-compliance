FROM docker.io/library/ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac

ARG OPENSCAP_SCANNER_VERSION

LABEL org.opencontainers.image.title="freesecdev-oscap-ci" \
      org.opencontainers.image.description="CI-only OpenSCAP image on the base of the SCC CI image, built locally and never published" \
      org.opencontainers.image.source="https://github.com/FreeSecDev/ansible-linux-compliance" \
      org.opencontainers.image.licenses="NOASSERTION" \
      org.opencontainers.image.version="${OPENSCAP_SCANNER_VERSION}"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN [[ "${OPENSCAP_SCANNER_VERSION}" =~ ^[0-9][0-9A-Za-z.+:~-]*$ ]] \
    && apt-get update \
    && apt-get install -y --no-install-recommends "openscap-scanner=${OPENSCAP_SCANNER_VERSION}" \
    && rm -rf /var/lib/apt/lists/* \
    && test "$(dpkg-query --show --showformat='${Version}' openscap-scanner)" = "${OPENSCAP_SCANNER_VERSION}" \
    && test "$(stat -c '%u:%g' /usr/bin/oscap)" = '0:0'

ENTRYPOINT ["/usr/bin/oscap"]
CMD ["--version"]
