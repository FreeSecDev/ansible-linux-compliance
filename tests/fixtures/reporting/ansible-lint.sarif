{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {"driver": {"name": "ansible-lint", "version": "0.0.0"}},
      "results": [
        {"ruleId": "name[casing]", "level": "warning", "message": {"text": "All names should start with an uppercase letter."}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "roles/demo/tasks/main.yml"}, "region": {"startLine": 4}}}]},
        {"ruleId": "syntax-check", "level": "error", "message": {"text": "Syntax problem <b>bold</b> & \"quotes\""}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "playbooks/site.yml"}}}]},
        {"ruleId": "yaml[line-length]", "level": "note", "message": {"text": "Line too long"}}
      ]
    }
  ]
}
